PLUGIN_DIR="$CONFIG_DIR/plugins"

bar=(
    position=top
    y_offset=5
    height=28
    margin=10
    corner_radius=10
    blur_radius=100
    color=0x10ffffff
)
sketchybar --bar "${bar[@]}"

default=(
  icon.font="JetBrainsMono Nerd Font:Bold:17.0"
  label.font="m6x11plus:Regular:20.0"
  icon.color=0xffffffff
  label.color=0xffffffff
)
sketchybar --default "${default[@]}"

sketchybar --add item apple left \
           --set apple icon=  \
                       icon.font.size=20 \
                       icon.color=0xff95a6db \
                       padding_right=10 \

sketchybar --add event aerospace_workspace_change
for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
               --subscribe space.$sid aerospace_workspace_change \
               --set space.$sid background.corner_radius=4 \
                                background.height=16 \
                                background.drawing=off \
                                label="$sid" \
                                label.font.size=16.0 \
                                label.padding_left=4 \
                                label.padding_right=5 \
                                padding_left=4 \
                                padding_right=4 \
                                script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done
sketchybar --set space.1 padding_left=8
sketchybar --set space.9 padding_right=8
sketchybar --add bracket spaces '/space\..*/' \
           --set spaces background.color=0x00000000 \
                        background.corner_radius=4 \
                        background.border_width=1 \
                        background.border_color=0xffffffff \
                        background.height=25

sketchybar --add item chevron left \
           --set chevron icon= \
                         label.drawing=off \
                         icon.font.size=12 \
                         padding_left=10 \
                         padding_right=10

sketchybar --add item front_app left \
           --subscribe front_app front_app_switched \
           --set front_app icon.drawing=off \
                           script="$PLUGIN_DIR/front_app.sh" \

sketchybar --add event aerospace_mode_change
sketchybar --add item aerospace_mode left \
           --subscribe aerospace_mode aerospace_mode_change \
           --set aerospace_mode label=main \
                                label.drawing=off \
                                label.align=center \
                                label.width=70 \
                                background.corner_radius=10 \
                                background.drawing=off \
                                background.height=25 \
                                padding_left=10 \
                                width=70 \
                                script="$CONFIG_DIR/plugins/aerospace-mode.sh"

sketchybar --add item clock right \
           --set clock update_freq=1 \
                       script="$PLUGIN_DIR/clock.sh" \
                       click_script="osascript $CONFIG_DIR/helpers/clock.applescript"

sketchybar --add alias "控制中心,BentoBox-0" right \
           --set "控制中心,BentoBox-0" click_script="osascript $CONFIG_DIR/helpers/control.applescript"

sketchybar --add alias "控制中心,WiFi" right \
           --set "控制中心,WiFi" click_script="osascript $CONFIG_DIR/helpers/wifi.applescript"
            
sketchybar --add alias "AlDente,Item-0" right \
           --set "AlDente,Item-0" click_script="osascript $CONFIG_DIR/helpers/aldente.applescript" \
                                  padding_left=10

sketchybar --add item ime right \
           --set ime label=A \
                     label.align=center \
                     label.width=30 \
                     label.font="苹方-简:Bold:12.0" \

# For some unknown reason, setting border for the label does not work
sketchybar --add bracket ime-bracket ime \
           --set ime-bracket background.color=0x00000000 \
                        background.corner_radius=4 \
                        background.border_width=1 \
                        background.border_color=0xffffffff \
                        background.height=20

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
sketchybar --set space.$(aerospace list-workspaces --focused) background.color=0xffd0eff7 label.color=0xff363636

$CONFIG_DIR/helpers/ime-0615
